<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (android:dataExtractionRules) : ni la sauvegarde cloud ni le
    transfert d'appareil à appareil ne doivent emporter les données locales
    (base SQLite financière, préférences, cache).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
